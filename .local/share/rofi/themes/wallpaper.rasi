* {
  main-bg:          #0B0E14F0;
  main-bg-no-alpha: #0B0E14;
  bg-pure:          #121620;
  border-color:     #1E2533;
  border-dark:      #2b3548;
  accent:           #FF5500;
  accent-tint:      rgba(255,85,0, 0.16);
  main-fg:          #E2E8F0;
  fg-muted:         #FF7847;
  fg-inverse:       #0b0e14;
  alert-red:        #E63946;
  alert-amber:      #F59E0B;

  spacing: 0;
  background-color: transparent;
}
