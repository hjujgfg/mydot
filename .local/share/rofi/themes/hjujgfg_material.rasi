

@import "./wallpaper.rasi"

window {
	transparency: "real";
	// background-color: #263238CC; /*base00 + CC (80% opacity)*/
	background-color: @main-bg;
	border-radius: 12px;
	border: 0px;

}

mainbox {
	children: [inputbar, message, mode-switcher, listview];
	spacing: 30px;
	padding: 30px 0;
	border-radius: 12px;
	border: 1px;
	border-color: @accent;
}

inputbar {
	padding: 0 30px;
	children: [prompt, textbox-prompt-colon, entry, case-indicator];
}

prompt {
	text-color: @main-fg;
}

textbox-prompt-colon {
	expand: false;
	str: ":";
	margin: 0 1ch 0 0;
	text-color: @main-bg;
}

entry {
	text-color: @main-fg;
}

case-indicator {
	text-color: @accent;
}

mode-switcher, message {
	border: 1px 0;
	border-color: @main-bg;
  border-radius: 12px;
}

button, textbox {
	background-color: @main-bg;
	text-color: @main-fg;
	padding: 5px;
}

button selected {
	background-color: @accent;
  text-color: @fg-inverse;
}

listview {
	scrollbar: true;
	margin: 0 10px 0 30px;
}

scrollbar {
	background-color: @accent;
	handle-color: @main-bg;
	handle-width: 10px;
	border: 0 1px;
	border-color: @main-bg;
	margin: 0 0 0 20px;
}

element {
	padding: 5px;
	spacing: 5px;
	highlight: bold underline;
	children: [element-icon, element-text];
}
element-text, element-icon {
	background-color : inherit;
	text-color	     : inherit;
	foreground-color : inherit;
}

element normal {
	background-color: transparent;
}

element selected {
	background-color: @accent;
	border-radius: 12px;
  text-color: @fg-inverse;
}

element selected active {
    text-color: @fg-inverse;
  }

element alternate {
	/*background-color: @base03;*/
}

element normal normal, element alternate normal {
	text-color: @main-fg;
}

element normal urgent, element selected urgent, element alternate urgent {
	text-color: @accent;
}

element normal active, element alternate active {
	text-color: @accent;
}

